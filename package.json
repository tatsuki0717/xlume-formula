{
  "name": "xlume-formula",
  "version": "0.1.0",
  "description": "Excel-compatible formula engine for xlume",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model/value": {
      "types": "./dist/model/value.d.ts",
      "import": "./dist/model/value.js"
    },
    "./model/address": {
      "types": "./dist/model/address.d.ts",
      "import": "./dist/model/address.js"
    },
    "./formula/evaluator": {
      "types": "./dist/formula/evaluator.d.ts",
      "import": "./dist/formula/evaluator.js"
    },
    "./formula/coercion": {
      "types": "./dist/formula/coercion.d.ts",
      "import": "./dist/formula/coercion.js"
    },
    "./formula/functions-types": {
      "types": "./dist/formula/functions-types.d.ts",
      "import": "./dist/formula/functions-types.js"
    },
    "./formula/graph": {
      "types": "./dist/formula/graph.d.ts",
      "import": "./dist/formula/graph.js"
    },
    "./formula/ast": {
      "types": "./dist/formula/ast.d.ts",
      "import": "./dist/formula/ast.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    },
    "./node-fetch-provider": {
      "types": "./dist/providers/node-fetch-provider.d.ts",
      "import": "./dist/providers/node-fetch-provider.js"
    },
    "./functions/builtins": {
      "types": "./dist/functions/builtins.d.ts",
      "import": "./dist/functions/builtins.js"
    }
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "bahttext": "2.4.0",
    "fast-xml-parser": "5.10.1",
    "jstat": "^1.9.6",
    "tinyld": "1.3.4"
  }
}

{
  "name": "xlume-formula",
  "version": "0.1.0",
  "description": "Excel-compatible formula engine for xlume",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@finprecise/bonds": "^0.3.0",
    "@finprecise/cashflow": "^0.3.0",
    "@finprecise/depreciation": "^0.3.0",
    "@floydspace/bond-calculator": "^0.2.0",
    "@formulajs/formulajs": "^4.6.1"
  }
}
